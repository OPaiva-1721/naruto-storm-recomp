string(RANDOM LENGTH 16 fixture_id)
set(DEST_FILE "${CMAKE_CURRENT_BINARY_DIR}/pc-controls-${fixture_id}.ini")
if(EXISTS "${DEST_FILE}")
    message(FATAL_ERROR "Fixture already exists")
endif()
include("${COPY_SCRIPT}")
file(SHA256 "${SOURCE_FILE}" expected)
file(SHA256 "${DEST_FILE}" actual)
if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Default config not copied")
endif()
file(WRITE "${DEST_FILE}" "custom user bindings\n")
include("${COPY_SCRIPT}")
file(READ "${DEST_FILE}" contents)
file(REMOVE "${DEST_FILE}")
if(NOT contents STREQUAL "custom user bindings\n")
    message(FATAL_ERROR "Existing user config overwritten")
endif()
